{
  "compilerOptions": {
    "outDir": "./dist-electron",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": "./electron"
  },
  "include": ["electron/**/*"],
  "exclude": ["node_modules", "dist-electron", "dist-renderer", "renderer"]
}
