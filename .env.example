# DeepSeek API（必填，AI 清洗/写作阶段需要）
DEEPSEEK_API_KEY=your_api_key_here

# 可选: DeepSeek API 地址
# DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 可选: 模型名称
# DEEPSEEK_MODEL=deepseek-chat

# 内置 Whisper 默认使用 vendor/whisper/whisper-cli 和 vendor/whisper/models/ggml-small.bin
# 可选: 覆盖开发环境 Whisper 资源路径
# WHISPER_CLI_BINARY=/absolute/path/to/whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.bin

# 可选: Remotion 渲染 Chrome 路径（Docker 中已自动配置）
# REMOTION_CHROME_PATH=/usr/bin/google-chrome
